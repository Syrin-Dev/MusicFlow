generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Added for Credentials auth
  accounts      Account[]
  sessions      Session[]
  likedSongs    LikedSong[]
  history       ListeningHistory[]
  playlists     Playlist[]
  
  // Settings
  displayName      String?
  bio              String?
  twoFactorEnabled Boolean @default(false)
  emailUpdates     Boolean @default(true)
  newReleases      Boolean @default(true)
  securityAlerts   Boolean @default(true)
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LikedSong {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  title     String
  artist    String
  thumbnail String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, videoId]) // User can like a song only once
}

model ListeningHistory {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  title     String
  artist    String
  thumbnail String
  playedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, playedAt])
}

// Detailed listening events for recommendation algorithm
model ListeningEvent {
  id              String   @id @default(cuid())
  userId          String
  videoId         String
  title           String
  artist          String
  
  // Engagement metrics
  playDuration    Int      // Seconds listened
  totalDuration   Int      // Total track duration
  completionRate  Float    // playDuration / totalDuration (0.0 - 1.0)
  
  // Explicit signals
  skipped         Boolean  @default(false)  // User skipped before 30s
  liked           Boolean  @default(false)  // User liked during/after play
  
  // Context features (for contextual recommendations)
  hourOfDay       Int      // 0-23
  dayOfWeek       Int      // 0-6 (Sunday = 0)
  
  // Timestamps
  startedAt       DateTime @default(now())
  endedAt         DateTime?
  
  @@index([userId, startedAt])
  @@index([userId, artist])
  @@index([videoId])
}

// Aggregated artist affinity scores (updated periodically)
model ArtistAffinity {
  id            String   @id @default(cuid())
  userId        String
  artist        String
  
  // Aggregated scores
  playCount     Int      @default(0)
  totalListenTime Int    @default(0)  // Total seconds
  likeCount     Int      @default(0)
  skipCount     Int      @default(0)
  avgCompletion Float    @default(0)  // Average completion rate
  
  // Calculated affinity score (higher = more preferred)
  affinityScore Float    @default(0)
  
  updatedAt     DateTime @updatedAt
  
  @@unique([userId, artist])
  @@index([userId, affinityScore])
}

model Playlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]
  
  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  title      String
  artist     String
  thumbnail  String
  addedAt    DateTime @default(now())
  
  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  
  @@unique([playlistId, videoId]) // Track can only be in playlist once
  @@index([playlistId])
}
