generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String             @id @default(cuid())
  name             String?
  email            String?            @unique
  emailVerified    DateTime?
  image            String?
  displayName      String?
  bio              String?
  twoFactorEnabled Boolean            @default(false)
  emailUpdates     Boolean            @default(true)
  newReleases      Boolean            @default(true)
  securityAlerts   Boolean            @default(true)
  password         String?
  inviteCode       String?            @unique
  lastActiveAt     DateTime?
  currentRoomId    String?
  lastTypingAt     DateTime?
  typingToId       String?
  accounts         Account[]
  activities       Activity[]
  friendOf         Friendship[]       @relation("FriendUsers")
  friends          Friendship[]       @relation("UserFriends")
  likedSongs       LikedSong[]
  history          ListeningHistory[]
  hostingRoom      ListeningRoom?     @relation("HostOfRoom")
  receivedMessages Message[]          @relation("ReceivedMessages")
  sentMessages     Message[]          @relation("SentMessages")
  notifications    Notification[]
  playlists        Playlist[]
  playlistRoles    PlaylistMember[]
  sessions         Session[]
  currentRoom      ListeningRoom?     @relation("RoomParticipants", fields: [currentRoomId], references: [id])
  searches         UserSearch[]
}

model Track {
  id              String             @id
  title           String
  artist          String
  thumbnail       String
  genres          String[]           @default([])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  activities      Activity[]
  likedBy         LikedSong[]
  listeningEvents ListeningEvent[]
  historyItems    ListeningHistory[]
  rooms           ListeningRoom[]
  playlistItems   PlaylistTrack[]
  messages        Message[]
}

model LikedSong {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())
  trackId   String?
  track     Track?   @relation(fields: [trackId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model ListeningHistory {
  id       String   @id @default(cuid())
  userId   String
  videoId  String
  playedAt DateTime @default(now())
  trackId  String?
  track    Track?   @relation(fields: [trackId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
}

model Playlist {
  id        String           @id @default(cuid())
  userId    String
  name      String
  thumbnail String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  isPublic  Boolean          @default(true)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  members   PlaylistMember[]
  tracks    PlaylistTrack[]

  @@index([userId])
}

model PlaylistMember {
  id         String       @id @default(cuid())
  playlistId String
  userId     String
  role       PlaylistRole @default(VIEWER)
  joinedAt   DateTime     @default(now())
  playlist   Playlist     @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  addedAt    DateTime @default(now())
  trackId    String?
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track?   @relation(fields: [trackId], references: [id])

  @@unique([playlistId, videoId])
  @@index([playlistId])
}

model Activity {
  id           String       @id @default(cuid())
  userId       String
  type         ActivityType
  trackId      String?
  playlistId   String?
  targetUserId String?
  createdAt    DateTime     @default(now())
  track        Track?       @relation(fields: [trackId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model UserSearch {
  id           String   @id @default(cuid())
  userId       String
  query        String
  count        Int      @default(1)
  lastSearched DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
}

model ListeningRoom {
  id            String   @id @default(cuid())
  hostId        String   @unique
  activeTrackId String?
  progress      Int      @default(0)
  isPublic      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  activeTrack   Track?   @relation(fields: [activeTrackId], references: [id])
  host          User     @relation("HostOfRoom", fields: [hostId], references: [id], onDelete: Cascade)
  participants  User[]   @relation("RoomParticipants")
}

model ListeningEvent {
  id             String   @id @default(cuid())
  userId         String
  videoId        String
  playDuration   Int
  totalDuration  Int
  completionRate Float
  skipped        Boolean  @default(false)
  liked          Boolean  @default(false)
  hourOfDay      Int
  dayOfWeek      Int
  startedAt      DateTime @default(now())
  trackId        String?
  track          Track?   @relation(fields: [trackId], references: [id])

  @@index([userId, startedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id                   String   @id @default(cuid())
  content              String?
  senderId             String
  receiverId           String
  sharedMusicId        String?
  createdAt            DateTime @default(now())
  isDeleted            Boolean  @default(false)
  replyToId            String?
  sharedMusicArtist    String?
  sharedMusicThumbnail String?
  sharedMusicTitle     String?
  receiver             User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender               User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  track                Track?   @relation(fields: [sharedMusicId], references: [id])
  replyTo              Message? @relation("MessageReplies", fields: [replyToId], references: [id])
  replies              Message[] @relation("MessageReplies")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Friendship {
  id        String           @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime         @default(now())
  status    FriendshipStatus @default(PENDING)
  friend    User             @relation("FriendUsers", fields: [friendId], references: [id], onDelete: Cascade)
  user      User             @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

enum PlaylistRole {
  OWNER
  EDITOR
  VIEWER
}

enum ActivityType {
  LIKE
  TRACK_PLAYED
  PLAYLIST_CREATED
  FRIEND_ADDED
  COMMENT_ADDED
}

enum NotificationType {
  FRIEND_REQUEST
  NEW_RELEASE
  SYSTEM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}
