generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String?            @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
  likedSongs    LikedSong[]
  history       ListeningHistory[]
  playlists     Playlist[]
  playlistRoles PlaylistMember[] // New: Collaborative playlists

  // Settings
  displayName      String?
  bio              String?
  twoFactorEnabled Boolean @default(false)
  emailUpdates     Boolean @default(true)
  newReleases      Boolean @default(true)
  securityAlerts   Boolean @default(true)

  // Friends & Messages
  friends          Friendship[] @relation("UserFriends")
  friendOf         Friendship[] @relation("FriendUsers")
  sentMessages     Message[]    @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")

  // Social & Personalization
  inviteCode    String?        @unique
  notifications Notification[]
  lastActiveAt  DateTime?
  typingToId    String? // ID of the friend the user is currently typing to
  lastTypingAt  DateTime? // Timestamp of last typing activity
  activities    Activity[] // New: Social feed source
  searches      UserSearch[] // New: Personalized search

  // Real-time Sync
  hostingRoom   ListeningRoom? @relation("HostOfRoom")
  currentRoomId String?
  currentRoom   ListeningRoom? @relation("RoomParticipants", fields: [currentRoomId], references: [id])
}

// --- CORE MUSIC DATA ---

model Track {
  id        String   @id // YouTube Video ID
  title     String
  artist    String
  thumbnail String
  genres    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Inverse relations
  likedBy         LikedSong[]
  historyItems    ListeningHistory[]
  playlistItems   PlaylistTrack[]
  listeningEvents ListeningEvent[]
  activities      Activity[]
  rooms           ListeningRoom[]
  messages        Message[]
}

model LikedSong {
  id        String   @id @default(cuid())
  userId    String
  videoId   String // Keep for easy query
  trackId   String? // Normalized link
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id])

  @@unique([userId, videoId])
}

model ListeningHistory {
  id       String   @id @default(cuid())
  userId   String
  videoId  String
  trackId  String?
  playedAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id])

  @@index([userId, playedAt])
}

// --- COLLABORATION & PLAYLISTS ---

model Playlist {
  id        String   @id @default(cuid())
  userId    String // Owner ID
  name      String
  thumbnail String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks  PlaylistTrack[]
  members PlaylistMember[] // Collaborators

  @@index([userId])
}

model PlaylistMember {
  id         String       @id @default(cuid())
  playlistId String
  userId     String
  role       PlaylistRole @default(VIEWER)
  joinedAt   DateTime     @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
}

enum PlaylistRole {
  OWNER
  EDITOR
  VIEWER
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  trackId    String?
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track?   @relation(fields: [trackId], references: [id])

  @@unique([playlistId, videoId])
  @@index([playlistId])
}

// --- SOCIAL & ANALYTICS ---

model Activity {
  id           String       @id @default(cuid())
  userId       String
  type         ActivityType
  trackId      String?
  playlistId   String?
  targetUserId String? // If action is directed at another user
  createdAt    DateTime     @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track? @relation(fields: [trackId], references: [id])

  @@index([userId, createdAt])
}

enum ActivityType {
  LIKE
  TRACK_PLAYED
  PLAYLIST_CREATED
  FRIEND_ADDED
  COMMENT_ADDED
}

model UserSearch {
  id           String   @id @default(cuid())
  userId       String
  query        String
  count        Int      @default(1)
  lastSearched DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, query])
}

// --- REAL-TIME SYNC ---

model ListeningRoom {
  id            String   @id @default(cuid())
  hostId        String   @unique
  activeTrackId String?
  progress      Int      @default(0) // Seconds
  isPublic      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  host         User   @relation("HostOfRoom", fields: [hostId], references: [id], onDelete: Cascade)
  activeTrack  Track? @relation(fields: [activeTrackId], references: [id])
  participants User[] @relation("RoomParticipants")
}

// --- EXISTING UTILITY MODELS ---

model ListeningEvent {
  id             String   @id @default(cuid())
  userId         String
  videoId        String
  trackId        String?
  playDuration   Int
  totalDuration  Int
  completionRate Float
  skipped        Boolean  @default(false)
  liked          Boolean  @default(false)
  hourOfDay      Int
  dayOfWeek      Int
  startedAt      DateTime @default(now())

  track Track? @relation(fields: [trackId], references: [id])

  @@index([userId, startedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum NotificationType {
  FRIEND_REQUEST
  NEW_RELEASE
  SYSTEM
}

model Message {
  id            String   @id @default(cuid())
  content       String?
  senderId      String
  receiverId    String
  sharedMusicId        String? // Normalized link to Track (videoId)
  sharedMusicTitle     String?
  sharedMusicArtist    String?
  sharedMusicThumbnail String?
  replyToId            String? // ID of the message being replied to
  isDeleted            Boolean  @default(false)
  createdAt            DateTime @default(now())

  sender   User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User      @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  track    Track?    @relation(fields: [sharedMusicId], references: [id])
  replyTo  Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies  Message[] @relation("MessageReplies")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Friendship {
  id        String           @id @default(cuid())
  userId    String
  friendId  String
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())

  user   User @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendUsers", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}
